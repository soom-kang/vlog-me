{
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./scripts/doctor.sh)",
      "Bash(python3 scripts/synthetic.py status *)",
      "Bash(python3 scripts/validate.py *)",
      "Bash(python3 scripts/inventory.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(raw/**)",
      "Edit(raw/**)",
      "Edit(sources/**)",
      "Write(raw/**)",
      "Write(sources/**)",
      "Bash(* raw/*)",
      "Bash(* ./raw/*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_sources.py\""
          }
        ]
      }
    ]
  }
}
